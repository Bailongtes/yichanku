    {
      "id": "bonegnasher",
      "name": "噬骨者",
      "en": "Bonegnasher",
      "category": "bestiary",
      "rarity": "legendary",
      "glyph": "🦴",
      "tags": ["荒原", "不死", "群体"],
      "desc": "以枯骨为食、以死者之骨增生躯壳的荒原猎食者。孤身时懦弱,结群时无畏。",
      "lore": [
        "噬骨者并非天生不死。荒原纪年第七百三十载,一支商队在盐水沼泽尽头的枯骨谷扎营。当夜无人存活,而次日清晨,营地里站起来的东西已经不认得人形了。",
        "它们啃食同类的骨骼来修补自己开裂的躯壳——越吃越庞大,越庞大越难被击倒。老练的猎人会说:别追单只的噬骨者,追它回巢,你会找到它已经长大到不需要逃跑的理由。"
      ],
      "stats": [
        { "label": "威胁等级", "value": 82 },
        { "label": "群体性",   "value": 94 },
        { "label": "再生能力", "value": 66 },
        { "label": "智慧",     "value": 28 },
        { "label": "抗打击",   "value": 77 }
      ],
      "weakness": "圣银锻打的钝器;骨骼接缝处",
      "drops": ["增生骨板", "腐化的骨髓", "噬骨者的獠牙"],
      "habitat": "盐水沼泽 · 枯骨谷",
      "related": ["hollowmantle", "embercolossus"]
    },
    {
      "id": "hollowmantle",
      "name": "空壳斗篷",
      "en": "Hollowmantle",
      "category": "bestiary",
      "rarity": "rare",
      "glyph": "👻",
      "tags": ["夜间", "幽影", "独居"],
      "desc": "一件无人穿着的斗篷,在夜里自己走。它寻找一个肩膀来归还——通常是在你还活着的时候。",
      "lore": [
        "空壳斗篷据说是被处决的刽子手的遗物。行刑者割下的头颅太多,某一天,他披着的那件斗篷开始替他继续工作。",
        "遇到它时不要奔跑。奔跑意味着你有体温,有体温意味着你合适。低下头,闭上眼,让它自己走过去。"
      ],
      "stats": [
        { "label": "威胁等级", "value": 58 },
        { "label": "群体性",   "value": 12 },
        { "label": "再生能力", "value": 41 },
        { "label": "智慧",     "value": 63 },
        { "label": "隐匿性",   "value": 91 }
      ],
      "weakness": "明火;被念出真名时",
      "drops": ["褪色的布片", "刽子手的线"],
      "habitat": "旧刑场 · 荒村",
      "related": ["bonegnasher", "therustedpang"]
    },
    {
      "id": "embercolossus",
      "name": "余烬巨像",
      "en": "Ember Colossus",
      "category": "bestiary",
      "rarity": "mythic",
      "glyph": "🔥",
      "tags": ["火山", "远古", "构造体"],
      "desc": "沉睡在熔岩海中的远古构造物。它醒来不是为了征服,只是翻了个身。",
      "lore": [
        "余烬巨像诞生于第一纪元的锻火之中,那时匠人们还未学会给武器起名字。它没有意识,只有记忆——一整座焚烧过的城市的记忆。",
        "记录者称,巨像每一次移动,大陆的某处就会多出一座火山。这或许只是巧合。愿它只是巧合。"
      ],
      "stats": [
        { "label": "威胁等级", "value": 100 },
        { "label": "群体性",   "value": 0 },
        { "label": "再生能力", "value": 88 },
        { "label": "智慧",     "value": 8 },
        { "label": "破坏力",   "value": 100 }
      ],
      "weakness": "无已知弱点;唯一的记录是『不要唤醒它』",
      "drops": ["熔核残片", "第一纪元的锻火"],
      "habitat": "熔岩海 · 焚风裂谷",
      "related": ["ashencodex", "bonegnasher"]
    },
    {
      "id": "saltwidow",
      "name": "盐沼寡妇",
      "en": "Salt Widow",
      "category": "bestiary",
      "rarity": "epic",
      "glyph": "🕷",
      "tags": ["湿地", "剧毒", "陷阱"],
      "desc": "在盐滩下织网的巨大节肢猎手。它的网不粘,它让猎物自己踩进干涸的盐壳裂缝里。",
      "lore": [
        "盐沼寡妇从不结出看得见的网。它在退潮的盐滩下挖掘迷宫般的隧道,然后用薄薄的盐壳封顶。旅人走着走着,脚下的世界就碎了。",
        "捕获到的寡妇腹中常见完整的人形轮廓——被盐腌渍,被时间风干,保存得比任何棺椁都好。"
      ],
      "stats": [
        { "label": "威胁等级", "value": 71 },
        { "label": "群体性",   "value": 34 },
        { "label": "毒性",     "value": 89 },
        { "label": "智慧",     "value": 47 },
        { "label": "隐匿性",   "value": 85 }
      ],
      "weakness": "干燥的强光;移除盐壳暴露巢穴",
      "drops": ["寡妇毒腺", "盐晶甲壳"],
      "habitat": "白盐滩 · 退潮带",
      "related": ["bonegnasher", "gloamroot"]
    },
